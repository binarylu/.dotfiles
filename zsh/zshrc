typeset -U path fpath

# ---------- history ----------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt extended_history hist_expire_dups_first hist_ignore_dups hist_ignore_space hist_verify share_history

# ---------- directories ----------
setopt auto_cd auto_pushd pushd_ignore_dups pushdminus interactive_comments
alias -g ...='../..'
alias ll='ls -lh' la='ls -lAh' l='ls -lah'
if [[ $OSTYPE == darwin* ]]; then alias ls='ls -G'; else alias ls='ls --color=auto'; fi

# ---------- key bindings ----------
bindkey -e
bindkey '^[[A' up-line-or-search
bindkey '^[[B' down-line-or-search
# Shift+Tab goes backwards in the completion menu
bindkey '^[[Z' reverse-menu-complete

# ---------- completion (cached; rebuild dump at most once a day) ----------
autoload -Uz compinit
() {
  setopt local_options extended_glob
  if [[ -n ~/.zcompdump(#qN.mh+24) ]]; then compinit; else compinit -C; fi
}
setopt complete_in_word always_to_end auto_menu
zstyle ':completion:*:*:*:*:*' menu select
# case-insensitive, then partial-word, then substring matching (as in oh-my-zsh)
zstyle ':completion:*' matcher-list \
  'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' \
  'r:|=*' \
  'l:|=* r:|=*'

# ---------- plugins via antidote (skipped if not installed) ----------
# Plugin list: ~/.zsh_plugins.txt (linked from this repo by setup.sh)
# HOMEBREW_PREFIX is set by `brew shellenv` (no need to spawn brew at startup)
for _antidote in ${HOMEBREW_PREFIX:-/opt/homebrew}/opt/antidote/share/antidote/antidote.zsh \
                 ~/.antidote/antidote.zsh; do   # 2nd: git-clone install (Linux)
  if [[ -f $_antidote ]]; then
    source $_antidote
    antidote load            # reads ~/.zsh_plugins.txt, caches to ~/.zsh_plugins.zsh
    break
  fi
done
unset _antidote

# ---------- prompt (last) ----------
(( $+commands[starship] )) && eval "$(starship init zsh)"

# machine-specific settings (PATH, secrets, work aliases) — not tracked
if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi
